{
  "Jwt": {
    "Issuer": "FluxoCaixa",
    "Audience": "FluxoCaixa",
    "Secret": "fluxo-caixa-secret-key-2026-super-secure"
  },
  "ReverseProxy": {
    "Routes": {
      "entries-route": {
        "ClusterId": "entries-cluster",
        "Match": {
          "Path": "/api/entries/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "consolidation-route": {
        "ClusterId": "consolidation-cluster",
        "Match": {
          "Path": "/api/consolidation/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      }
    },
    "Clusters": {
      "entries-cluster": {
        "Destinations": {
          "entries-destination": {
            "Address": "http://entries-api:8080"
          }
        }
      },
      "consolidation-cluster": {
        "Destinations": {
          "consolidation-destination": {
            "Address": "http://consolidation-api:8080"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}